# =================================
# FreeTour IA - Backend Configuration
# =================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://freetour:freetour_pass@localhost:5432/freetour_db"

# --- Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-64-characters-replace-this-now

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,https://your-app-domain.com

# --- AI Configuration ---
# Provider: "openai" | "generic-llm" | "local"
AI_PROVIDER=openai

# OpenAI API Key (get from https://platform.openai.com)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000

# --- Text-to-Speech ---
# Provider: "openai" | "generic-tts" | "none"
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
# Voices: alloy, echo, fable, onyx, nova, shimmer

# --- Storage (for audio files) ---
# Provider: "local" | "s3"
STORAGE_PROVIDER=local
AUDIO_STORAGE_PATH=./uploads/audio

# --- S3 Storage (if STORAGE_PROVIDER=s3) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=freetour-audio
# AWS_S3_REGION=eu-west-1

# --- Generic LLM Provider (if AI_PROVIDER=generic-llm) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama

# --- Generic TTS Provider (if TTS_PROVIDER=generic-tts) ---
# TTS_BASE_URL=http://localhost:8880
# TTS_MODEL=kokoro
