default_platform(:ios)

platform :ios do
  desc "Build the iOS app and submit it to TestFlight"
  lane :beta do
    # Authenticate with App Store Connect API (no Apple ID password / 2FA)
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_API_KEY_PATH"],
      in_house: false,
    )

    bundle_id = ENV["APP_BUNDLE_ID"] || "com.freetour.ia"
    team_id   = ENV["APPLE_TEAM_ID"]

    # App creation handled externally via REST API before the workflow runs.

    # Get/Create distribution cert via API key (no 2FA needed)
    cert(
      api_key: api_key,
      development: false,
    )

    # Get/Create app-store provisioning profile
    sigh(
      api_key: api_key,
      app_identifier: bundle_id,
      force: true,
    )

    # Build number based on TestFlight latest + 1 (uses built-in increment_build_number)
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: bundle_id,
      initial_build_number: 0,
    ).to_i
    increment_build_number(
      xcodeproj: "ios/FreeTourIA.xcodeproj",
      build_number: (latest_build + 1).to_s,
    )

    # Configure code signing in the .xcodeproj generated by Expo prebuild
    update_project_team(
      path: "ios/FreeTourIA.xcodeproj",
      teamid: team_id,
    )

    profile_name = lane_context[SharedValues::SIGH_NAME] || "iOS Team Provisioning Profile: #{bundle_id}"

    # Build the .ipa using Xcode (manual signing with the profile we just provisioned)
    gym(
      workspace: "ios/FreeTourIA.xcworkspace",
      scheme: "FreeTourIA",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "ios/build",
      output_name: "FreeTourIA.ipa",
      export_options: {
        method: "app-store",
        teamID: team_id,
        signingStyle: "manual",
        provisioningProfiles: { bundle_id => profile_name },
      },
      xcargs: "DEVELOPMENT_TEAM=#{team_id} CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='#{profile_name}' -allowProvisioningUpdates",
    )

    # Upload to TestFlight (don't wait for processing)
    pilot(
      api_key: api_key,
      ipa: "ios/build/FreeTourIA.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      apple_id: nil,
      app_identifier: bundle_id,
    )

    UI.success("✅ FreeTour IA build uploaded to TestFlight. Processing on Apple's side: ~5-15 min.")
  end
end
